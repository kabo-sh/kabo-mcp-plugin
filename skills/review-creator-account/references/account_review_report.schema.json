{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-ai.local/schemas/account-review-report.v3.json",
  "title": "AccountReviewReport V3",
  "description": "Slim native account review with personal baselines, directly attached evidence, and next-cycle actions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "profile_id", "status", "scope", "data_coverage", "headline", "diagnosis", "baselines", "what_works", "what_hurts", "recommendations", "data_gaps"],
  "properties": {
    "schema_version": {"const": "account-review-report.v3", "description": "Report contract version."},
    "report_id": {"type": "string", "minLength": 1, "description": "Unique review identifier."},
    "profile_id": {"type": "string", "minLength": 1, "description": "CreatorProfile associated with this review."},
    "status": {"enum": ["complete", "partial", "blocked"], "description": "Review completion status."},
    "scope": {"$ref": "#/$defs/scope"},
    "data_coverage": {"$ref": "#/$defs/data_coverage"},
    "headline": {"type": "string", "minLength": 1, "maxLength": 80, "description": "Creator-facing editorial headline generated in the single semantic synthesis."},
    "diagnosis": {"type": "string", "minLength": 1, "description": "Single most important account diagnosis."},
    "baselines": {"type": "array", "description": "Personal comparable-format baselines used in this review.", "items": {"$ref": "#/$defs/baseline"}},
    "what_works": {"type": "array", "description": "Winning semantic patterns with directly attached content evidence.", "items": {"$ref": "#/$defs/resolved_pattern"}},
    "what_hurts": {"type": "array", "description": "Losing semantic patterns with directly attached content evidence.", "items": {"$ref": "#/$defs/resolved_pattern"}},
    "recommendations": {"$ref": "#/$defs/recommendations"},
    "growth_estimate": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "input_sha256", "question_sha256", "result"], "properties": {"snapshot_id": {"type": "string", "minLength": 1}, "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "result": {"$ref": "growth_estimate.schema.json"}}, "description": "Optional content scenario recomputed from this report snapshot and original user request; not semantic synthesis."},
    "data_gaps": {"type": "array", "uniqueItems": true, "description": "Missing data that limits interpretation.", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "description": "Platform, account, source mode, snapshot, and observation window.",
      "required": ["snapshot_id", "platform", "source_mode", "account", "window", "observed_at"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "source_mode": {"type": "string", "minLength": 1},
        "account": {"type": "string", "minLength": 1},
        "window": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": ["string", "null"]}, "end": {"type": ["string", "null"]}}},
        "observed_at": {"type": "string", "minLength": 1}
      }
    },
    "data_coverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Content and metric coverage for this review.",
      "required": ["content_total", "formats", "metric_available_counts", "source_coverage", "missing"],
      "properties": {
        "content_total": {"type": "integer", "minimum": 0},
        "formats": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "metric_available_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "source_coverage": {"type": "object"},
        "missing": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "normalization": {"type": "object"},
        "format_classification": {"$ref": "#/$defs/format_classification"}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "maturity_days", "sample_size", "metrics"],
      "properties": {
        "format": {"type": "string"},
        "maturity_days": {"type": "integer", "minimum": 1},
        "sample_size": {"type": "integer", "minimum": 0},
        "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric_summary"}},
        "format_classification": {"$ref": "#/$defs/format_classification"}
      }
    },
    "format_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence_counts", "source_counts"],
      "properties": {
        "confidence_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "source_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "metric_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_n", "median", "mean"],
      "properties": {
        "available_n": {"type": "integer", "minimum": 0},
        "median": {"type": ["number", "null"]},
        "mean": {"type": ["number", "null"]}
      }
    },
    "recommendations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Continue, stop, and test actions.",
      "required": ["continue", "stop", "test"],
      "properties": {
        "continue": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "stop": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "test": {"type": "array", "items": {"$ref": "#/$defs/action"}}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "success_metric": {"type": "string", "minLength": 1}
      }
    },
    "resolved_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "explanation", "examples"],
      "properties": {
        "pattern": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1},
        "examples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/content_example"}}
      }
    },
    "content_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "title", "format", "metrics", "view_multiple_vs_format_median"],
      "properties": {
        "content_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"]},
        "format": {"type": "string", "minLength": 1},
        "format_confidence": {"type": "string", "minLength": 1},
        "format_source": {"type": "string", "minLength": 1},
        "metrics": {"type": "object", "additionalProperties": {"type": "number"}},
        "view_multiple_vs_format_median": {"type": ["number", "null"]}
      }
    }
  }
}
