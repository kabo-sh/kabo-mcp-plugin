{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-ai.local/schemas/owner-follow-contribution.v1.json",
  "title": "Owner Follow Contribution V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "window", "coverage", "rows", "rankings", "groups", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "owner-follow-contribution.v1"},
    "status": {
      "enum": ["complete", "insufficient"],
      "description": "complete means at least one in-window row has an observed Follows value (including zero), so computable results were produced. It does not mean complete data coverage, computability of every efficiency metric, or sufficient evidence for a content decision. insufficient means no in-window row has an observed Follows value."
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": ["string", "null"]},
        "end": {"type": ["string", "null"]}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_rows", "in_window_rows", "follows_available_n", "views_available_n", "reach_available_n"],
      "properties": {
        "input_rows": {"type": "integer", "minimum": 1},
        "in_window_rows": {"type": "integer", "minimum": 1},
        "follows_available_n": {"type": "integer", "minimum": 0},
        "views_available_n": {"type": "integer", "minimum": 0},
        "reach_available_n": {"type": "integer", "minimum": 0}
      }
    },
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "rankings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute_follows", "follows_per_1000_views", "follows_per_1000_reach"],
      "properties": {
        "absolute_follows": {"$ref": "#/$defs/ranking"},
        "follows_per_1000_views": {"$ref": "#/$defs/ranking"},
        "follows_per_1000_reach": {"$ref": "#/$defs/ranking"}
      }
    },
    "groups": {"type": "array", "items": {"type": "object"}},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_supplied_rows_only", "missing_values_are_zero", "causal_attribution"],
      "properties": {
        "owner_supplied_rows_only": {"const": true},
        "missing_values_are_zero": {"const": false},
        "causal_attribution": {"const": false}
      }
    }
  },
  "$defs": {
    "ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "content_id", "value"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "content_id": {"type": "string", "minLength": 1},
          "value": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
