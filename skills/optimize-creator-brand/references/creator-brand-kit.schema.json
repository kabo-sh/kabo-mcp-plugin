{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creator-brand-kit.v1",
  "title": "Creator Brand Kit",
  "description": "A one-page identity kit a creator sends to brands (media kit / press kit / brand kit). Every number carries where it came from, every account carries who supplied it, and prices are never part of the kit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "delivery_language",
    "mode",
    "identity",
    "collaboration_formats",
    "representative_works",
    "metrics",
    "contact",
    "profile_checklist",
    "accounts_provenance",
    "missing",
    "rate_card"
  ],
  "properties": {
    "schema_version": {
      "const": "creator-brand-kit.v1"
    },
    "task": {
      "const": "brand_kit"
    },
    "delivery_language": {
      "anyOf": [
        {
          "enum": [
            "English",
            "中文"
          ]
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        }
      ],
      "description": "BCP-47 tag of the language the Creator-facing strings are written in, such as en, zh-CN or pt-BR. The v1 values English and 中文 remain valid. Fixed labels in the rendered result are English."
    },
    "mode": {
      "enum": [
        "account",
        "checklist"
      ],
      "description": "account = a kit for a named account, filled from the creator and from public profiles actually resolved. checklist = no account: what a brand looks at on a profile, with nothing about any particular account."
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positioning",
        "niche",
        "audience"
      ],
      "properties": {
        "positioning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "niche": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    },
    "collaboration_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "What the creator can do with a brand (dedicated video, integration, UGC for the brand's own channels ...). Formats only - never a price."
    },
    "representative_works": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "platform",
          "handle",
          "selection"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "handle": {
            "type": "string",
            "minLength": 1
          },
          "selection": {
            "enum": [
              "curated_highlight",
              "recent_sample"
            ],
            "description": "curated_highlight = picked because it did well; it must never read as typical performance. recent_sample = the latest posts, unpicked."
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "platform",
          "handle",
          "source",
          "source_url",
          "retrieved_at"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "handle": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "user_supplied",
              "resolved_public"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required when source is resolved_public: the public profile the number was read from."
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required when source is resolved_public."
          }
        }
      }
    },
    "contact": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "value",
            "source"
          ],
          "properties": {
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "const": "user_supplied",
              "description": "A contact route comes from the creator. It is never looked up or guessed."
            }
          }
        }
      ]
    },
    "profile_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "basis",
          "source_url"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "official",
              "inferred"
            ],
            "description": "official = a field the platform's own creator marketplace or help page names; inferred = our suggestion. They are printed apart."
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required when basis is official."
          }
        }
      }
    },
    "accounts_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "handle",
          "source"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "handle": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "user_supplied",
              "resolved_public"
            ]
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "What the kit would normally carry and this run could not obtain. Left empty in the kit and listed here instead of filled in."
    },
    "rate_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handled_by",
        "note"
      ],
      "properties": {
        "handled_by": {
          "const": "price-creator-brand-deals"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "description": "Pricing is a separate conversation. The kit points to it and never carries a figure."
    }
  }
}
