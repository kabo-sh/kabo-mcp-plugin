{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creator-brand-options.v1",
  "title": "Creator Brand Options",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "delivery_language",
    "options"
  ],
  "properties": {
    "schema_version": {
      "const": "creator-brand-options.v1"
    },
    "task": {
      "type": "string",
      "enum": [
        "youtube_channel_name",
        "instagram_bio",
        "instagram_username",
        "tiktok_bio",
        "tiktok_username"
      ]
    },
    "delivery_language": {
      "anyOf": [
        {
          "enum": [
            "English",
            "中文"
          ]
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        }
      ],
      "description": "BCP-47 tag of the language the Creator-facing strings are written in, such as en, zh-CN or pt-BR. The v1 values English and 中文 remain valid. Fixed labels in the rendered result are English."
    },
    "requested_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "The request's requested_count, copied when the creator named a number. options then holds exactly that many; without it, options holds the task default (10 for channel names and usernames, 8 for bios)."
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "rationale"
        ],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150
          },
          "rationale": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "availability_status": {
            "type": "string",
            "enum": [
              "unverified",
              "available",
              "taken",
              "check_failed"
            ]
          },
          "strategy": {
            "type": "string",
            "minLength": 1,
            "description": "Which angle this option takes - the name of the group it belongs to, not a restatement of the option. Options that all take the same angle are spelling variants, and the creator cannot choose between them."
          }
        }
      }
    },
    "recommended": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "description": "The shortlist, in order. Every entry must be one of the options above: recommending something that was never offered is how a candidate with no validation reaches the creator.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "reason"
        ],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "One sentence on why this one, not a repeat of its rationale."
          }
        }
      }
    }
  }
}