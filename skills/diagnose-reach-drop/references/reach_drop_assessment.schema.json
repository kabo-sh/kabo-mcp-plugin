{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-ai.local/schemas/reach-drop-assessment.v3.json",
  "title": "Question-scoped Traffic Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform",
    "account",
    "input_digest",
    "sources",
    "coverage",
    "questions",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "reach-drop-assessment.v3"
    },
    "platform": {
      "enum": [
        "instagram",
        "tiktok",
        "youtube"
      ]
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "imported_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "record_count"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "record_count": {"type": "integer", "minimum": 0},
        "coverage": {"type": "object", "description": "Unmodified upstream coverage metadata, bound to the supplied AccountAnalysis."}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "public",
              "owner_export",
              "user_supplied",
              "synthetic"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "ask",
          "intent",
          "status",
          "facts",
          "limits",
          "missing"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "recent_drop",
              "growth",
              "traffic_sources",
              "audience"
            ]
          },
          "ask": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "enum": [
              "explain",
              "diagnose",
              "act"
            ]
          },
          "status": {
            "enum": [
              "needs_data",
              "partial",
              "computed"
            ]
          },
          "audience_target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "population", "categories", "criterion", "definition"],
            "properties": {
              "dimension": {"type": "string", "minLength": 1},
              "population": {"type": "string", "minLength": 1},
              "categories": {"type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}},
              "criterion": {"$ref": "#/$defs/audience_criterion"},
              "definition": {"$ref": "#/$defs/audience_target_definition"}
            }
          },
          "audience_verdict": {
            "enum": ["met", "not_met", "baseline_only", "unknown", "mixed", "unmeasured"]
          },
          "available_measurements": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["question_id", "metric", "basis", "record_ids"],
              "properties": {
                "question_id": {"type": "string", "minLength": 1},
                "metric": {"type": "string", "minLength": 1},
                "basis": {"enum": ["performance", "period_totals"]},
                "record_ids": {"type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "format",
                    "metric",
                    "groups",
                    "change",
                    "comparison",
                    "limits",
                    "record_ids",
                    "target_gap"
                  ],
                  "properties": {
                    "type": {
                      "const": "performance"
                    },
                    "format": {
                      "type": "string",
                      "minLength": 1
                    },
                    "metric": {
                      "type": "string",
                      "minLength": 1
                    },
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "label",
                          "n",
                          "selected_n",
                          "median",
                          "max",
                          "sample_sum",
                          "age_hours",
                          "publication_range",
                          "record_ids"
                        ],
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "n": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "selected_n": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "median": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "max": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "sample_sum": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "age_hours": {
                            "anyOf": [
                              {
                                "type": "null"
                              },
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "min",
                                  "max"
                                ],
                                "properties": {
                                  "min": {
                                    "type": "number"
                                  },
                                  "max": {
                                    "type": "number"
                                  }
                                }
                              }
                            ]
                          },
                          "publication_range": {
                            "type": ["array", "null"],
                            "items": {"type": "string"},
                            "minItems": 2,
                            "maxItems": 2
                          },
                          "record_ids": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "uniqueItems": true
                          }
                        }
                      }
                    },
                    "change": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "before",
                            "after",
                            "difference",
                            "ratio"
                          ],
                          "properties": {
                            "before": {
                              "type": "number"
                            },
                            "after": {
                              "type": "number"
                            },
                            "difference": {
                              "type": "number"
                            },
                            "ratio": {
                              "type": [
                                "number",
                                "null"
                              ]
                            }
                          }
                        }
                      ]
                    },
                    "comparison": {
                      "enum": [
                        "limited",
                        "same_age_descriptive"
                      ]
                    },
                    "limits": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "record_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "target": {"type": "number", "minimum": 0},
                    "target_basis": {"enum": ["each_record", "group_median"]},
                    "target_evaluation": {"$ref": "#/$defs/performance_target_evaluation"},
                    "target_gap": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "metric",
                    "population",
                    "source",
                    "window_basis",
                    "groups",
                    "share_change",
                    "count_change",
                    "total_change",
                    "per_post_count_change",
                    "per_post_total_change",
                    "record_ids"
                  ],
                  "properties": {
                    "type": {
                      "const": "traffic_sources"
                    },
                    "metric": {
                      "type": "string",
                      "minLength": 1
                    },
                    "population": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "window_basis": {
                      "type": "array",
                      "items": {}
                    },
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "label",
                          "n",
                          "total",
                          "count",
                          "weighted_share",
                          "per_post_total_mean",
                          "per_post_count_mean",
                          "per_post_count_median",
                          "reported_shares",
                          "estimated_from_share",
                          "window",
                          "record_ids"
                        ],
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "n": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "total": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "count": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "weighted_share": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "per_post_total_mean": {"type": ["number", "null"]},
                          "per_post_count_mean": {"type": ["number", "null"]},
                          "per_post_count_median": {"type": ["number", "null"]},
                          "reported_shares": {
                            "type": "array",
                            "items": {
                              "type": [
                                "number",
                                "null"
                              ]
                            }
                          },
                          "estimated_from_share": {
                            "type": "boolean"
                          },
                          "window": {"type": "object"},
                          "record_ids": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "uniqueItems": true
                          }
                        }
                      }
                    },
                    "share_change": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "before",
                            "after",
                            "difference",
                            "ratio"
                          ],
                          "properties": {
                            "before": {
                              "type": "number"
                            },
                            "after": {
                              "type": "number"
                            },
                            "difference": {
                              "type": "number"
                            },
                            "ratio": {
                              "type": [
                                "number",
                                "null"
                              ]
                            }
                          }
                        }
                      ]
                    },
                    "count_change": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "before",
                            "after",
                            "difference",
                            "ratio"
                          ],
                          "properties": {
                            "before": {
                              "type": "number"
                            },
                            "after": {
                              "type": "number"
                            },
                            "difference": {
                              "type": "number"
                            },
                            "ratio": {
                              "type": [
                                "number",
                                "null"
                              ]
                            }
                          }
                        }
                      ]
                    },
                    "per_post_count_change": {"$ref": "#/$defs/nullable_change"},
                    "per_post_total_change": {"$ref": "#/$defs/nullable_change"},
                    "total_change": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "before",
                            "after",
                            "difference",
                            "ratio"
                          ],
                          "properties": {
                            "before": {
                              "type": "number"
                            },
                            "after": {
                              "type": "number"
                            },
                            "difference": {
                              "type": "number"
                            },
                            "ratio": {
                              "type": [
                                "number",
                                "null"
                              ]
                            }
                          }
                        }
                      ]
                    },
                    "record_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "dimension",
                    "population",
                    "window",
                    "target_categories",
                    "target_share_range",
                    "reported_distribution_share",
                    "target_criterion",
                    "target_status",
                    "record_ids"
                  ],
                  "properties": {
                    "type": {
                      "const": "audience"
                    },
                    "dimension": {
                      "type": "string",
                      "minLength": 1
                    },
                    "population": {
                      "type": "string",
                      "minLength": 1
                    },
                    "window": {
                      "type": ["object", "null"]
                    },
                    "target_categories": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "target_share_range": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "reported_distribution_share": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1.000000000001
                    },
                    "target_criterion": {"$ref": "#/$defs/audience_criterion"},
                    "target_status": {"enum": ["met", "not_met", "baseline_only", "unknown"]},
                    "record_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "metric",
                    "population",
                    "groups",
                    "change",
                    "publishing_change",
                    "record_ids"
                  ],
                  "properties": {
                    "type": {
                      "const": "period_totals"
                    },
                    "publishing_change": {
                      "$ref": "#/$defs/nullable_change"
                    },
                    "metric": {
                      "type": "string",
                      "minLength": 1
                    },
                    "population": {
                      "type": "string",
                      "minLength": 1
                    },
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "label",
                          "value",
                          "posts_published",
                          "window"
                        ],
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "number"
                          },
                          "posts_published": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "window": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "change": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "before",
                            "after",
                            "difference",
                            "ratio"
                          ],
                          "properties": {
                            "before": {
                              "type": "number"
                            },
                            "after": {
                              "type": "number"
                            },
                            "difference": {
                              "type": "number"
                            },
                            "ratio": {
                              "type": [
                                "number",
                                "null"
                              ]
                            }
                          }
                        }
                      ]
                    },
                    "record_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
                }
              ]
            }
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_enforcement_inferred",
        "causes_established"
      ],
      "properties": {
        "platform_enforcement_inferred": {
          "const": false
        },
        "causes_established": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "audience_criterion": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"],
         "properties": {"kind": {"enum": ["largest_share", "increase"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"],
         "properties": {"kind": {"const": "minimum_share"}, "value": {"type": "number", "minimum": 0, "maximum": 1}}}
      ]
    },
    "audience_target_definition": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "source_text"],
         "properties": {"status": {"const": "user_explicit"}, "source_text": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "confirmation"],
         "properties": {"status": {"const": "provisional"}, "confirmation": {"type": "string", "minLength": 1}}}
      ]
    },
    "performance_target_evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "basis", "groups"],
      "properties": {
        "value": {"type": "number", "minimum": 0},
        "basis": {"enum": ["each_record", "group_median"]},
        "groups": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["label", "n", "met_n", "met_share", "decision_value", "gap", "met"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "n": {"type": "integer", "minimum": 0},
            "met_n": {"type": "integer", "minimum": 0},
            "met_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "decision_value": {"type": ["number", "null"]},
            "gap": {"type": ["number", "null"]},
            "met": {"type": "boolean"}
          }
        }}
      }
    },
    "nullable_change": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["before", "after", "difference", "ratio"],
          "properties": {
            "before": {"type": "number"},
            "after": {"type": "number"},
            "difference": {"type": "number"},
            "ratio": {"type": ["number", "null"]}
          }
        }
      ]
    }
  }
}
