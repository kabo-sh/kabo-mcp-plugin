  "cpm_model": {
    "source": "cpm.d1",
    "formula": "(average_views / 1000) * niche_cpm * format_multiplier",
    "basis": "average_views",
    "rationale": "Follower count and delivered reach diverge often enough that a follower tier alone misprices both directions.",
    "niches": [
      { "niche": "gaming", "cpm_low": 15, "cpm_high": 30 },
      { "niche": "technology", "cpm_low": 25, "cpm_high": 45 },
      { "niche": "finance", "cpm_low": 30, "cpm_high": 60 }
    ],
    "format_multipliers": [
      { "format": "dedicated_video", "low": 1.3, "high": 1.5 },
      { "format": "integration", "low": 1.0, "high": 1.0 },
      { "format": "short_video", "low": 0.4, "high": 0.6 }
    ]
  },
  "negotiation_rules": [
    { "id": "no_number_before_terms", "rule": "Do not name a figure until usage rights, exclusivity and the deliverable list are settled.", "sources": ["negotiate.e1", "negotiate.e2", "internal.leo_v2"], "why": "The first number spoken anchors the deal, and the terms that are still undefined are most of the price." },
    { "id": "open_above_target", "rule": "Open above the number you would accept.", "low_pct": 20, "high_pct": 30, "sources": ["internal.leo_v2"], "note": "The internal framework's figure. The practitioner guides read for this framework give no percentage; one says outright there is no set percent." },
    { "id": "counter_every_offer", "rule": "Counter an offer that comes in below your floor; walk away if the brand will not move on rate or terms.", "sources": ["negotiate.e1"], "why": "A low first offer is an opening, not a verdict, but a deal under your floor is not worth keeping." },
    { "id": "reprice_on_schedule", "rule": "Raise rates on a schedule rather than on a feeling.", "low_pct": 10, "high_pct": 20, "sources": ["internal.leo_v2"], "note": "The internal framework's annual figure; no practitioner guide read for this framework gives a schedule." },
    { "id": "discount_requires_scope_cut", "rule": "Never discount the same deliverable. Trade a lower price for explicitly less scope.", "sources": ["negotiate.e2"] }
  ],
  "divergences": [
    {
      "topic": "exclusivity",
      "internal_position": "base fee multiplied by the number of exclusive months, so three months prices at three times base",
      "adopted_position": "duration bands: category lock-out from +20-35% for 30 days to +100-150% for 12 months; full exclusivity +50-80% for 30 days, +100-175% for 90 days",
      "adopted_sources": ["conv.c2"],
      "decision": "external",
      "decided_on": "2026-08-28",
      "rationale": "Every external source prices exclusivity below the internal multiplier. Quoting three times base for a three-month lock-out would read as unfamiliar with the market."
    },
    {
      "topic": "usage_rights_structure",
      "internal_position": "20-100% of the content fee per 30-day window",
      "adopted_position": "a licence fee by duration (up to 90 days +20-50%, six months +20-30%), with paid use inside that fee; longer, perpetual and buyout licences priced separately",
      "adopted_sources": ["conv.c1", "bench.a2"],
      "decision": "external",
      "decided_on": "2026-08-28",
      "rationale": "The published sources price a licence by duration and count paid use as part of that fee; none publishes a perpetual or buyout figure, so those are left to be priced separately rather than guessed."
    },
    {
      "topic": "tier_table_shape",
      "internal_position": "one platform-agnostic tier table plus a flat platform premium",
      "adopted_position": "per-platform bands; platform is never applied again as a lever",
      "adopted_sources": ["bench.a1", "bench.a2", "txn.b1"],
      "decision": "external",
      "decided_on": "2026-08-28",
      "rationale": "No external source prices platforms as one table, and transacted averages differ by platform. Applying a platform premium on top of per-platform bands would count it twice."
    }
  ],
  "corroborations": [
    {
      "topic": "instagram_over_tiktok",
      "internal_position": "Instagram runs about 30% above TikTok",
      "evidence": "transacted averages of 288 against 217, a 32.7% gap",
      "evidence_sources": ["txn.b1"],
      "status": "supported"
    }
  ]
