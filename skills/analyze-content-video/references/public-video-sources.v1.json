      ],
      "canonical_url": "https://www.kuaishou.com/short-video/{id}",
      "metadata_route": "media_call",
      "public_metrics": {
        "views": true,
        "likes": true,
        "comments": true,
        "shares": true,
        "saves": true
      },
      "notes": "Media downloads from the platform CDN are slow from the server; the smallest rendition is fetched."
    },
    {
      "id": "facebook",
      "label": "Facebook",
      "content_id_prefix": "fb",
      "page_hosts": [
        "www.facebook.com",
        "facebook.com",
        "m.facebook.com",
        "web.facebook.com"
      ],
      "short_link_hosts": [
        "fb.watch"
      ],
      "short_link_path_patterns": [
        "^/share/(?:r|v)/[A-Za-z0-9_-]{4,64}/?$"
      ],
      "url_patterns": [
        "^/reel/(\\d{5,25})/?$",
        "^/watch/?$",
        "^/[A-Za-z0-9.\\-]{1,100}/videos/(?:[^/]{1,200}/)?(\\d{5,25})/?$"
      ],
      "query_id_params": [
        "v"
      ],
      "canonical_url": "https://www.facebook.com/watch/?v={id}",
      "metadata_route": "media_call",
      "public_metrics": {
        "views": true,
        "likes": true,
        "comments": true,
        "shares": true,
        "saves": false
      },
      "notes": "Views are the page's own rounded display (video.view_count_basis); when that cannot be read the count is withheld, never taken from the downloader."
    },
    {
