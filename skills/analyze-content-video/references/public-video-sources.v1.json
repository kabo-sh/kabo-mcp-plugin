{
  "schema_version": "public-video-sources.v1",
  "sources": [
    {
      "id": "youtube",
      "label": "YouTube",
      "content_id_prefix": "yt",
      "page_hosts": [
        "youtube.com",
        "www.youtube.com",
        "m.youtube.com",
        "youtu.be"
      ],
      "short_link_hosts": [],
      "url_patterns": [
        "^/watch$",
        "^/(?:shorts|embed|live)/([A-Za-z0-9_-]{11})/?$",
        "^/v/([A-Za-z0-9_-]{11})/?$",
        "^/([A-Za-z0-9_-]{11})/?$"
      ],
      "query_id_params": [
        "v"
      ],
      "canonical_url": "https://www.youtube.com/watch?v={id}",
      "metadata_route": "youtube_get_video",
      "public_metrics": {
        "views": true,
        "likes": true,
        "comments": true,
        "shares": false,
        "saves": false
      },
      "notes": "The single-segment 11-character pattern is for youtu.be only; on youtube.com such a path is not a video page."
    },
    {
      "id": "instagram",
      "label": "Instagram",
      "content_id_prefix": "ig",
      "page_hosts": [
        "instagram.com",
        "www.instagram.com",
        "m.instagram.com"
      ],
      "short_link_hosts": [],
      "url_patterns": [
        "^/(?:reel|reels|p|tv)/([A-Za-z0-9_-]{3,80})/?$",
        "^/[A-Za-z0-9._]{1,30}/(?:reels?|p|tv)/([A-Za-z0-9_-]{5,64})/?$"
      ],
      "canonical_url": "https://www.instagram.com/reel/{id}/",
      "metadata_route": "media_call",
      "public_metrics": {
        "views": true,
        "likes": true,
        "comments": true,
        "shares": false,
        "saves": false
      },
      "notes": "Likes can be hidden by the creator; a hidden count is missing, not zero."
    },
    {
      "id": "tiktok",
      "label": "TikTok",
      "content_id_prefix": "tt",
      "page_hosts": [
        "tiktok.com",
        "www.tiktok.com",
        "m.tiktok.com"
      ],
      "short_link_hosts": [
        "vm.tiktok.com",
        "vt.tiktok.com"
      ],
      "url_patterns": [
        "^/@[A-Za-z0-9._]{1,64}/video/([0-9]{1,30})/?$",
        "^/@[A-Za-z0-9._]{1,64}/photo/([0-9]{8,25})/?$"
      ],
      "canonical_url": "https://www.tiktok.com/@/video/{id}",
      "metadata_route": "media_call",
      "public_metrics": {
        "views": true,
        "likes": true,
        "comments": true,
        "shares": true,
        "saves": true
      },
      "notes": "The canonical form drops the author handle; keep the pasted page URL as the fetch target."
    },
    {
      "id": "douyin",
      "label": "Douyin",
      "content_id_prefix": "dy",
      "page_hosts": [
        "douyin.com",
        "www.douyin.com",
        "m.douyin.com",
        "iesdouyin.com",
        "www.iesdouyin.com"
      ],
      "short_link_hosts": [
        "v.douyin.com"
      ],
      "url_patterns": [
        "^/video/(\\d{8,32})/?$",
        "^/note/(\\d{8,32})/?$",
        "^/share/video/(\\d{8,32})/?$"
      ],
      "canonical_url": "https://www.douyin.com/video/{id}",
      "metadata_route": "media_call",
      "public_metrics": {
        "views": false,
        "likes": true,
        "comments": true,
        "shares": true,
        "saves": true
      },
      "notes": "Mainland Douyin. Not TikTok."
    },
    {
      "id": "xiaohongshu",
      "label": "Xiaohongshu",
      "content_id_prefix": "xhs",
      "page_hosts": [
        "www.xiaohongshu.com",
        "xiaohongshu.com",
        "www.rednote.com",
        "rednote.com"
      ],
      "short_link_hosts": [
        "xhslink.com",
        "www.xhslink.com"
      ],
      "url_patterns": [
        "^/explore/([0-9a-f]{24})/?$",
        "^/discovery/item/([0-9a-f]{24})/?$"
      ],
      "canonical_url": "https://www.xiaohongshu.com/explore/{id}",
      "metadata_route": "media_call",
      "public_metrics": {
        "views": false,
        "likes": true,
        "comments": true,
        "shares": true,
        "saves": true
      },
      "notes": "Includes RedNote links. Web links usually carry xsec_token; send the original URL to the server, not the canonical one."
    },
    {
      "id": "kuaishou",
      "label": "Kuaishou",
      "content_id_prefix": "ks",
      "page_hosts": [
        "www.kuaishou.com",
        "kuaishou.com"
      ],
      "short_link_hosts": [
        "v.kuaishou.com"
      ],
