{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-ai.local/schemas/selected-idea.v2.json",
  "title": "SelectedIdeaV2",
  "description": "A user selection snapshot. It carries semantic context references, not the removed V2 Opportunity/evidence-signal objects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selected_idea_id", "source_idea_set_id", "source_candidate_id", "selection_status", "selected_at", "user_edits", "confirmed_constraints", "idea"],
  "properties": {
    "schema_version": {"const": "selected-idea.v2"},
    "selected_idea_id": {"type": "string", "minLength": 1},
    "source_idea_set_id": {"type": "string", "minLength": 1},
    "source_candidate_id": {"type": "string", "minLength": 1},
    "selection_status": {"enum": ["selected", "selected_with_edits"]},
    "selected_at": {"type": "string", "format": "date-time"},
    "user_edits": {"type": "array", "items": {"type": "string"}},
    "confirmed_constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["goal", "audience", "desired_audience_action", "language", "time_per_item", "budget", "filming_mode", "editing_capacity", "publishing_cadence"],
      "properties": {
        "goal": {"type": "string", "minLength": 1}, "audience": {"type": "string", "minLength": 1}, "desired_audience_action": {"type": "string", "minLength": 1}, "language": {"type": "string", "minLength": 1},
        "time_per_item": {"type": ["string", "null"]}, "budget": {"type": ["string", "null"]}, "filming_mode": {"type": ["string", "null"]}, "editing_capacity": {"type": ["string", "null"]}, "publishing_cadence": {"type": ["string", "null"]}
      }
    },
    "idea": {
      "type": "object", "additionalProperties": false,
      "required": ["working_title", "audience_problem", "content_promise", "angle", "platforms", "formats", "hook_preview", "content_outline", "source_context_refs", "evidence_refs", "differentiation", "must_differ", "required_assets", "risks"],
      "properties": {
        "working_title": {"type": "string", "minLength": 1}, "audience_problem": {"type": "string", "minLength": 1}, "content_promise": {"type": "string", "minLength": 1}, "angle": {"type": "string", "minLength": 1},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "hook_preview": {"type": "object", "additionalProperties": false, "required": ["opening_line", "progressive_line", "mechanism"], "properties": {"opening_line": {"type": "string", "minLength": 1}, "progressive_line": {"type": ["string", "null"]}, "mechanism": {"type": "string", "minLength": 1}}},
        "content_outline": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["order", "beat", "purpose", "evidence_refs"], "properties": {"order": {"type": "integer", "minimum": 1}, "beat": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}}},
        "source_context_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "primary_evidence_ref": {"type": ["string", "null"]}, "differentiation": {"type": "string", "minLength": 1}, "must_differ": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "required_assets": {"type": "array", "items": {"type": "string"}}, "risks": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
