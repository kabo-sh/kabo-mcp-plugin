{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-ai.local/schemas/monetization-plan.v1.json",
  "title": "MonetizationPlan V1",
  "description": "The native product contract for platform-native monetization planning: which programs exist, where the creator stands against each one, what is still missing, and which assumptions any revenue figure rests on. Creator-facing text is a projection of this object and is never parsed back into it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "generated_at",
    "as_of",
    "rule_library",
    "creator",
    "account_facts",
    "programs",
    "revenue_scenarios",
    "assumption_ledger",
    "data_gaps",
    "claim_boundary",
    "revenue_inputs_needed",
    "revenue_not_available",
    "niche_comparison",
    "income_rows",
    "income_totals",
    "income_breakdown_requested"
  ],
  "properties": {
    "schema_version": {
      "const": "monetization-plan.v1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 10
    },
    "as_of": {
      "type": "string",
      "minLength": 10,
      "description": "The date eligibility is evaluated against. A rule that is not yet effective on this date cannot decide a gate."
    },
    "rule_library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library_version",
        "compiled_at",
        "staleness_budget_days"
      ],
      "properties": {
        "library_version": {
          "type": "string",
          "minLength": 1
        },
        "compiled_at": {
          "type": "string",
          "minLength": 10
        },
        "staleness_budget_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "account",
        "region",
        "participation",
        "region_source"
      ],
      "properties": {
        "platform": {
          "enum": [
            "youtube",
            "instagram",
            "tiktok"
          ]
        },
        "account": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 2,
          "description": "The country THIS ACCOUNT is registered in - not where the person lives. One creator can hold accounts registered in different countries, and eligibility follows the account, so a US-registered channel and a CN-registered one belonging to the same person get different verdicts. ISO 3166-1 alpha-2, or UNKNOWN."
        },
        "participation": {
          "enum": [
            "new_applicant",
            "existing_participant",
            "unknown"
          ],
          "description": "Which eligibility path applies. A grandfathered bar and a new-applicant bar can differ for the same program."
        },
        "region_source": {
          "enum": [
            "account_declared",
            "user_stated",
            "unknown"
          ],
          "description": "Provenance of the account's country. Never inferred from content."
        }
      },
      "description": "The account being assessed. Every field here is scoped to this one account, not to the person behind it: the same creator's other accounts can sit in different countries and different programmes."
    },
    "account_facts": {
      "type": "array",
      "description": "Observed and estimated readings kept in separate fields. A downstream consumer must always be able to tell which is which; nothing merges them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "observed",
          "estimated"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "unit",
                  "basis",
                  "retrieved_at"
                ],
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "enum": [
                      "public_account_facts",
                      "owner_authorized_analytics",
                      "user_supplied"
                    ],
                    "description": "Where the reading came from. Public facts are never labelled owner-verified."
                  },
                  "retrieved_at": {
                    "type": "string",
                    "minLength": 10
                  },
                  "coverage_complete": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "sample_size": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "estimated": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "unit",
                  "assumption_ref"
                ],
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "assumption_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            ]
          },
          "caveat": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/program_assessment"
      }
    },
    "revenue_scenarios": {
      "type": "array",
      "description": "Empty unless the caller supplied the rates these rest on. This Skill does not carry a default rate: an unsourced number here would be indistinguishable from a promise.",
      "items": {
        "$ref": "#/$defs/revenue_scenario"
      }
    },
    "assumption_ledger": {
      "type": "array",
      "description": "The ledger, not a disclaimer. Every estimated reading and every revenue figure resolves to an entry here; an entry with no source says so.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "statement",
          "origin"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "enum": [
              "user_supplied",
              "model_estimate",
              "rule_library",
              "not_supplied"
            ],
            "description": "model_estimate is a figure the caller worked out rather than one the creator gave; a scenario resting on it is a model, not the creator's own numbers. not_supplied records an assumption the plan needed and did not get; it is why a scenario is absent."
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "rule_library"
                }
              },
              "required": [
                "origin"
              ]
            },
            "then": {
              "required": [
                "source_url"
              ],
              "properties": {
                "source_url": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "data_gaps": {
      "type": "array",
      "description": "Every metric a rule needed and the run could not obtain, with what would unblock it. This is a first-class output: it is the evidence for what to build next, not an error log.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "availability",
          "blocks",
          "what_would_unblock"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "enum": [
              "available_with_caveat",
              "partial",
              "needs_authorization",
              "unavailable"
            ],
            "description": "Why the metric could not settle its gate. available_with_caveat appears when a reading exists but its bound cannot confirm the threshold in the direction the rule asks."
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "what_would_unblock": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion_kind",
        "guarantees_eligibility",
        "guarantees_earnings",
        "owner_verified_metrics_used"
      ],
      "properties": {
        "conclusion_kind": {
          "const": "rule_comparison"
        },
        "guarantees_eligibility": {
          "const": false
        },
        "guarantees_earnings": {
          "const": false
        },
        "owner_verified_metrics_used": {
          "type": "boolean"
        }
      }
    },
    "revenue_inputs_needed": {
      "type": "array",
      "description": "For each programme whose figure could not be computed, the specific inputs that were missing and where the creator finds them. Every programme in this library has one side observable and one side not, so this list - not an empty revenue section - is the honest answer.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program_id",
          "input_name",
          "unit",
          "label",
          "where_to_find"
        ],
        "properties": {
          "program_id": {
            "type": "string",
            "minLength": 1
          },
          "input_name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "where_to_find": {
            "type": [
              "string",
              "null"
            ]
          },
          "i18n": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "revenue_not_available": {
      "type": "array",
      "description": "Programmes for which no amount exists to compute, with the reason. Distinct from revenue_inputs_needed, which lists figures that WOULD produce an amount if supplied: nothing supplied here would help.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program_id",
          "reason"
        ],
        "properties": {
          "program_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "i18n": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "niche_comparison": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "niches",
        "rate",
        "competition"
      ],
      "description": "Present when the creator asked which niche pays better. Two halves, answered differently: the rate from the rule library, the competition handed back to research. Null otherwise.",
      "properties": {
        "niches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "published",
            "note",
            "checked"
          ],
          "properties": {
            "published": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Null when this platform's pages were never checked; the note then says so instead of claiming the rate is unpublished."
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "i18n": {
              "type": [
                "object",
                "null"
              ]
            },
            "checked": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "platform",
                  "source_url",
                  "source_title",
                  "verified_at",
                  "quote"
                ],
                "properties": {
                  "platform": {
                    "enum": [
                      "youtube",
                      "instagram",
                      "tiktok"
                    ]
                  },
                  "source_url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "source_title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verified_at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "published": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "published"
                ]
              },
              "then": {
                "properties": {
                  "checked": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "published": {
                    "type": "null"
                  }
                },
                "required": [
                  "published"
                ]
              },
              "then": {
                "properties": {
                  "checked": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        },
        "competition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "research_skill",
            "question"
          ],
          "properties": {
            "status": {
              "enum": [
                "handed_back",
                "not_asked"
              ]
            },
            "research_skill": {
              "type": [
                "string",
                "null"
              ]
            },
            "question": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "income_rows": {
      "type": "array",
      "description": "The platform-payout part of an income breakdown: one row per programme, priced or not. Priced rows are this plan's revenue scenarios; see income-row.v1.schema.json.",
      "items": {
        "$ref": "income-row.v1.schema.json#/$defs/row"
      }
    },
    "income_totals": {
      "type": "array",
      "description": "Sums over rows sharing one rate origin, period and currency. Empty by default: there is never a total across origins.",
      "items": {
        "$ref": "income-row.v1.schema.json#/$defs/total"
      }
    },
    "income_breakdown_requested": {
      "type": "boolean",
      "description": "True when the request asked for an income breakdown; the report then prints the rows as a table."
    }
  },
  "$defs": {
    "rule_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "regions",
        "effective_from",
        "effective_until",
        "verified_at",
        "verification_status"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "enum": [
            "verified",
            "unverified_draft"
          ]
        }
      }
    },
    "requirement_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "metric_id",
        "comparator",
        "threshold",
        "unit",
        "outcome",
        "bound",
        "basis"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "comparator": {
          "enum": [
            "gte",
            "lte",
            "eq"
          ]
        },
        "threshold": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "window_days": {
          "type": [
            "integer",
            "null"
          ]
        },
        "any_of_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "enum": [
            "met",
            "not_met",
            "indeterminate_rounding",
            "needs_authorization",
            "unavailable_metric",
            "estimated_only",
            "not_assessable"
          ],
          "description": "met and not_met are reserved for a decision made against an observed value. estimated_only marks a comparison that only an assumption could complete. indeterminate_rounding marks an observed value whose published precision cannot resolve the threshold."
        },
        "observed_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "gap": {
          "type": [
            "number",
            "null"
          ],
          "description": "How much is still missing, in unit. Null whenever the outcome was not decided against an observed value."
        },
        "projection": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "days_to_threshold",
                "rate_value",
                "rate_unit",
                "assumption_ref"
              ],
              "properties": {
                "days_to_threshold": {
                  "type": "number",
                  "minimum": 0
                },
                "rate_value": {
                  "type": "number"
                },
                "rate_unit": {
                  "type": "string",
                  "minLength": 1
                },
                "assumption_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "projected_date": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ],
          "description": "Time-to-threshold for a cumulative gate. Present only when the caller supplied the rate; it is a scenario, never a date the platform committed to."
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "bound": {
          "enum": [
            "exact",
            "upper",
            "lower"
          ],
          "description": "Carried from the metric. It decides how an estimated_only outcome must be explained: an upper-bound reading that clears the bar cannot confirm it, while a lower-bound reading that falls short cannot refute it. Those are opposite messages and must not share one sentence."
        },
        "basis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "public_account_facts",
                "owner_authorized_analytics",
                "user_supplied"
              ]
            }
          ],
          "description": "Where the deciding reading came from, carried from account_facts. A figure the creator typed in settles the arithmetic but is not a retrieved fact, and the report must not present the two the same way. Null when nothing was read."
        }
      }
    },
    "path_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "applies_to",
        "rule_status",
        "outcome",
        "requirements",
        "effective_from"
      ],
      "properties": {
        "path_id": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "enum": [
            "new_applicant",
            "existing_participant",
            "any"
          ]
        },
        "outcome": {
          "enum": [
            "met",
            "not_met",
            "undetermined"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement_outcome"
          }
        },
        "rule_status": {
          "enum": [
            "usable",
            "unverified",
            "stale",
            "expired",
            "not_yet_effective",
            "region_not_applicable"
          ],
          "description": "Evaluated against this path's own provenance, not just the program's. A programme can hold a current bar and a future bar at once; only a path that is itself verified, in force on as_of and applicable to the region may decide anything."
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "program_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_id",
        "platform",
        "family",
        "display_name",
        "what_it_pays_for",
        "rule_status",
        "eligibility",
        "decided_by_path",
        "paths",
        "source",
        "additional_requirements_not_assessed",
        "region_checked"
      ],
      "properties": {
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "youtube",
            "instagram",
            "tiktok"
          ]
        },
        "family": {
          "enum": [
            "ad_share",
            "memberships",
            "fan_funding",
            "subscriptions",
            "gifts",
            "bonuses",
            "creator_rewards",
            "paid_content",
            "commerce"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "what_it_pays_for": {
          "type": "string",
          "minLength": 1
        },
        "rule_status": {
          "enum": [
            "usable",
            "unverified",
            "stale",
            "expired",
            "not_yet_effective",
            "region_not_applicable"
          ],
          "description": "Whether the rule was allowed to decide eligibility at all. Only usable may produce eligible or not_eligible."
        },
        "eligibility": {
          "enum": [
            "eligible",
            "not_eligible",
            "partially_determined",
            "undetermined"
          ]
        },
        "decided_by_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path_outcome"
          }
        },
        "source": {
          "$ref": "#/$defs/rule_source"
        },
        "additional_requirements_not_assessed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Carried through from the rule library. Non-empty means the verdict is capped at partially_determined."
        },
        "i18n": {
          "type": [
            "object",
            "null"
          ],
          "description": "Creator-facing prose per language tag, carried through from the rule library unchanged."
        },
        "region_checked": {
          "type": "boolean",
          "description": "False when the rule is limited to countries the library has not transcribed, so the creator's own country was never compared against the list. Like an unchecked requirement, it caps the verdict."
        }
      }
    },
    "revenue_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "program_id",
        "model",
        "period",
        "currency",
        "low",
        "high",
        "formula",
        "assumption_refs",
        "conditional_on_eligibility",
        "inputs",
        "after_tax",
        "note",
        "includes_programs"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "enum": [
            "revenue_share",
            "fan_payment",
            "platform_fund",
            "commission"
          ],
          "description": "Platform-native payout models only. Brand-deal pricing is a different contract with different units and is not representable here."
        },
        "period": {
          "enum": [
            "monthly",
            "annual"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 3
        },
        "low": {
          "type": "number",
          "minimum": 0
        },
        "high": {
          "type": "number",
          "minimum": 0
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "assumption_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Ledger entries this figure rests on. Empty is legitimate and is the strongest case: it means every input was retrieved rather than assumed. What is never legitimate is an input with no source at all."
        },
        "conditional_on_eligibility": {
          "type": "boolean",
          "description": "True when the creator is not yet eligible for the program this scenario prices."
        },
        "inputs": {
          "type": "array",
          "description": "Every value that went into the figure, with where it came from. A reader must be able to see which half was retrieved and which half the creator supplied.",
          "items": {
            "type": "object"
          }
        },
        "after_tax": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "low",
            "high",
            "rate_percent",
            "assumption_ref"
          ],
          "description": "The same range after the creator's tax rate. Null unless a tax_rate was supplied or modelled - then the figure is pre-tax and the report says so.",
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0
            },
            "high": {
              "type": "number",
              "minimum": 0
            },
            "rate_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "assumption_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "note": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          },
          "description": "What the figure is net of and what it covers, keyed by language. Null when the programme has nothing to add."
        },
        "includes_programs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Programmes whose income this figure already contains. A scenario for one of them may sit beside this one; the two must never be added together."
        }
      }
    }
  }
}
