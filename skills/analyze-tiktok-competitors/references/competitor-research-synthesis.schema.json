{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kabo.sh/schemas/competitor-research-synthesis.v3.1.json",
  "title": "CompetitorResearchSynthesisV3_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "request_id",
    "status",
    "overview",
    "competitors",
    "featured_content_refs",
    "patterns",
    "gaps",
    "data_gaps"
  ],
  "properties": {
    "schema_version": {"const": "competitor-research-synthesis.v3.1"},
    "report_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial", "blocked"]},
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "key_findings", "next_action"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 80, "description": "Short Creator-facing editorial headline generated by the synthesis model. Name the competitive move and the opening it creates; do not use a task label, scope statement or methodology."},
        "summary": {"type": "string", "minLength": 1, "description": "Creator-facing headline conclusion. Name the competitive mechanism and the opening it creates for this Creator; do not lead with scope, method or data limitations."},
        "key_findings": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}},
        "next_action": {"type": "string", "minLength": 1}
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account_ref", "relationship", "summary"],
        "properties": {
          "account_ref": {"type": "string", "minLength": 1, "description": "Canonical creator_id from public-content-snapshot.v1; a unique public handle is accepted only as a Composer fallback."},
          "relationship": {"enum": ["direct", "adjacent", "media"]},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "featured_content_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "patterns": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/pattern"}
    },
    "gaps": {
      "type": "array",
      "items": {"$ref": "#/$defs/gap"}
    },
    "data_gaps": {
      "type": "array",
      "maxItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "mechanism",
        "account_refs",
        "content_refs",
        "audience_problem",
        "content_promise",
        "angle",
        "recommended_formats",
        "why_now",
        "creator_fit",
        "differentiation",
        "must_avoid"
      ],
      "properties": {
        "pattern": {"type": "string", "minLength": 1, "description": "Compact editorial section heading that names the competitor move and its stakes or consequence. Prefer natural tension over a generic category label; vary wording across patterns."},
        "mechanism": {"type": "string", "minLength": 1, "description": "Concise Creator-facing explanation of why the competitor mechanism works. Keep research method and audit inventory out."},
        "account_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "description": "Canonical creator_id from public-content-snapshot.v1."}},
        "content_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "audience_problem": {"type": "string", "minLength": 1},
        "content_promise": {"type": "string", "minLength": 1},
        "angle": {"type": "string", "minLength": 1},
        "recommended_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "why_now": {"type": "string", "minLength": 1},
        "creator_fit": {"type": "string", "minLength": 1},
        "differentiation": {"type": "string", "minLength": 1},
        "must_avoid": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "summary", "content_refs"],
      "properties": {
        "type": {"enum": ["positioning", "topic", "format", "audience_problem"]},
        "summary": {"type": "string", "minLength": 1},
        "content_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
