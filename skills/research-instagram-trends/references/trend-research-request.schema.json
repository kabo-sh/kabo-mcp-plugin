{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kabo.sh/schemas/trend-research-request.v3.json",
  "title": "TrendResearchRequestV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "mode", "niche", "platforms", "window", "locale", "formats"],
  "properties": {
    "schema_version": {"const": "trend-research-request.v3"},
    "request_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["current_popular", "recurring_patterns", "momentum", "emerging_creators"]},
    "niche": {"type": "string", "minLength": 1},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["instagram", "youtube"]}},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["since", "until"],
      "properties": {
        "since": {"type": "string", "format": "date-time"},
        "until": {"type": "string", "format": "date-time"}
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "language"],
      "properties": {
        "region": {"type": ["string", "null"]},
        "language": {"type": ["string", "null"]},
        "named_in_ask": {"type": ["string", "null"], "description": "Required when region or language is not null: the user's own words, copied exactly from the ask, that name the market or content language (\"Spanish videos\", \"in Brazil\"). The ask's own language is not one; discover checks this quote against the ask."}
      }
    },
    "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "creator_profile": {
      "type": ["object", "null"],
      "properties": {
        "platform": {"type": "string"},
        "handle": {"type": "string", "minLength": 1},
        "display_name": {"type": "string"},
        "public_profile_url": {"type": "string"},
        "observed_content_mechanisms": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "observed_caption_phrases": {"type": "array", "uniqueItems": true, "description": "Recurring short phrases copied verbatim from the anchor Creator's own captions, in the original content language, ranked by how many distinct posts contain them. Source is creator-profile.v3 content_profile.caption_phrases. Never paraphrase, reorder, or translate these: discovery matches literally against captions, so an intent written in analyst vocabulary retrieves a pool with no same-format content in it.", "items": {"type": "string", "minLength": 1}}
      }
    },
    "seed_queries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
