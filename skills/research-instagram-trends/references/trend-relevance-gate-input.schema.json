{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kabo.sh/schemas/trend-relevance-gate-input.v1.json",
  "title": "TrendRelevanceGateInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "platform", "subject", "items"],
  "properties": {
    "schema_version": {"const": "trend-relevance-gate-input.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["instagram", "youtube"]},
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["niche", "region", "language"],
      "properties": {
        "niche": {"type": "string", "minLength": 1},
        "region": {"type": ["string", "null"]},
        "language": {"type": ["string", "null"]},
        "anchor_handle": {"type": ["string", "null"]},
        "anchor_mechanisms": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "signature_content": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "description": "The Creator's signature content from the saved account profile, in Request order. number is the value a score line's signature_content column names (0 means none); id is the Request's id for it.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["number", "id", "name", "topic", "approach", "examples"],
            "properties": {
              "number": {"type": "integer", "minimum": 1, "maximum": 4},
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "topic": {"type": "string", "minLength": 1},
              "approach": {"type": "string", "minLength": 1},
              "examples": {"type": "array", "maxItems": 2, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["content_key", "visible_text"],
        "properties": {
          "content_key": {"type": "string", "minLength": 1},
          "creator_label": {"type": "string", "minLength": 1},
          "visible_text": {"type": "string"},
          "platform_summary": {"type": "string", "minLength": 1, "maxLength": 160,
                               "description": "The platform's own description of the item, not written by its author."},
          "matched_queries": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
