{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kabo.sh/schemas/trend-research-synthesis.v3.3.json",
  "title": "TrendResearchSynthesisV3_3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "request_id",
    "status",
    "overview",
    "featured_content_refs",
    "patterns",
    "emerging_creators",
    "data_gaps"
  ],
  "properties": {
    "schema_version": {"const": "trend-research-synthesis.v3.3"},
    "report_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial", "blocked"]},
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "key_findings", "next_action"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 80, "description": "Short Creator-facing editorial headline generated by the synthesis model. Make the strongest evidence-backed contrast or opportunity immediately visible; do not use a task label, scope statement or methodology."},
        "summary": {"type": "string", "minLength": 1, "description": "Creator-facing headline conclusion. Begin directly with the strongest contrast, consequence or opportunity revealed by the evidence. Never mention the research window, dates, capture time, snapshot status, candidate or analyzed counts, coverage, methods, or data limitations."},
        "key_findings": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}},
        "next_action": {"type": "string", "minLength": 1}
      }
    },
    "featured_content_refs": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "patterns": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/pattern"}
    },
    "emerging_creators": {
      "type": "array",
      "items": {"$ref": "#/$defs/emergingCreator"}
    },
    "data_gaps": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "complete"}}},
    "then": {"properties": {"featured_content_refs": {"minItems": 1}}}
  }],
  "$defs": {
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pattern",
        "mechanism",
        "stage",
        "content_refs",
        "audience_problem",
        "content_promise",
        "angle",
        "recommended_formats",
        "why_now",
        "creator_fit",
        "differentiation",
        "must_avoid"
      ],
      "properties": {
        "type": {"enum": ["topic", "hook", "format", "packaging", "audience_problem", "mixed"]},
        "pattern": {"type": "string", "minLength": 1, "description": "Compact editorial section heading that names both the visible content move and why it matters. Prefer natural tension or consequence over a taxonomy label; vary wording across patterns."},
        "mechanism": {"type": "string", "minLength": 1, "description": "Concise Creator-facing explanation of how the pattern earns attention or action. Keep methodology and audit inventory out."},
        "stage": {"enum": ["current_high_performance", "recurring_pattern", "rising", "falling"]},
        "content_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "audience_problem": {"type": "string", "minLength": 1},
        "content_promise": {"type": "string", "minLength": 1},
        "angle": {"type": "string", "minLength": 1},
        "recommended_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "why_now": {"type": "string", "minLength": 1},
        "creator_fit": {"type": "string", "minLength": 1},
        "differentiation": {"type": "string", "minLength": 1},
        "must_avoid": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "emergingCreator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator_ref", "status", "summary", "content_refs"],
      "properties": {
        "creator_ref": {"type": "string", "minLength": 1},
        "status": {"enum": ["small_account_outlier", "breakout_confirmed"]},
        "summary": {"type": "string", "minLength": 1},
        "content_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
