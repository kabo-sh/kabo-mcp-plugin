{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kabo.sh/schemas/trend-query-plan.v1.json",
  "title": "TrendQueryPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "intents"],
  "properties": {
    "schema_version": {"const": "trend-query-plan.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent_id", "search_query"],
        "properties": {
          "intent_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "search_query": {"type": "string", "minLength": 2, "maxLength": 240},
          "popular_topic": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    }
  }
}
