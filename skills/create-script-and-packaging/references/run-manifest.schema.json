{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kabo.sh/schemas/script-run-manifest.v1.json",
  "title": "ScriptPackageRunManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "request_id", "package_id", "skill", "runtime", "validation", "source_contributions", "fallbacks", "artifacts"],
  "properties": {
    "schema_version": {"const": "script-run-manifest.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "minLength": 1},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "create-script-and-packaging"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "model"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "validator"],
      "properties": {
        "status": {"const": "passed"},
        "validator": {"const": "scripts/validate_script_package.py"}
      }
    },
    "source_contributions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "fallbacks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
