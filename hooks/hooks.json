{
  "description": "Offer Kabo onboarding once, in the first Claude Code session after the plugin is installed.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/onboarding-nudge.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
